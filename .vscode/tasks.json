{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pipeline completo - medalhão",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "mba_setup_ambiente.py",
        "--bucket",
        "datalake-bucket-turma-c-trabalho-mba",
        "--quantidade",
        "100"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Validar camadas Athena - medalhão",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "mba_validar_camadas_athena.py",
        "datalake-bucket-turma-c-trabalho-mba"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Análise Athena - medalhão",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "mba_analise_athena.py",
        "datalake-bucket-turma-c-trabalho-mba"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Testes locais",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q", "proximas_etapas/scripts"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
